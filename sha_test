    function automatic bit [1:0] calc_block_wr_num(
        input int unsigned len_byte
    );

        // --------------------------------------------------------
        // 完全照你照片裡的 SHA_test_gen.py：
        //
        // if len/8 % 4 == 0:
        //     block_wr_num = 3
        // elif len/8 % 3 == 0:
        //     block_wr_num = 2
        // elif len/8 % 2 == 0:
        //     block_wr_num = 1
        // else:
        //     block_wr_num = 0
        //
        // 因為這裡 len_byte 已經是 byte 數，
        // 所以直接對 len_byte 做 %
        // --------------------------------------------------------

        if ((len_byte % 4) == 0)
            return 2'd3;

        else if ((len_byte % 3) == 0)
            return 2'd2;

        else if ((len_byte % 2) == 0)
            return 2'd1;

        else
            return 2'd0;

    endfunction



