    // ============================================================
    // 64-bit rotate left
    //
    // Keccak Rho step 會用到
    // ============================================================

    function automatic bit [63:0] rotl64(
        input bit [63:0] value,
        input int unsigned sh
    );

        if (sh == 0)
            return value;

        return
            (value << sh)
            |
            (value >> (64-sh));

    endfunction



    // ============================================================
    // Rho rotation offset
    //
    // SHA3 / Keccak-f[1600] 固定 rotation table
    // ============================================================

    function automatic int unsigned rho_offset(
        input int x,
        input int y
    );

        case (y)

            0:
                case(x)
                    0:return 0;
                    1:return 1;
                    2:return 62;
                    3:return 28;
                    4:return 27;
                endcase

            1:
                case(x)
                    0:return 36;
                    1:return 44;
                    2:return 6;
                    3:return 55;
                    4:return 20;
                endcase

            2:
                case(x)
                    0:return 3;
                    1:return 10;
                    2:return 43;
                    3:return 25;
                    4:return 39;
                endcase

            3:
                case(x)
                    0:return 41;
                    1:return 45;
                    2:return 15;
                    3:return 21;
                    4:return 8;
                endcase

            4:
                case(x)
                    0:return 18;
                    1:return 2;
                    2:return 61;
                    3:return 56;
                    4:return 14;
                endcase

        endcase

        return 0;

    endfunction



    // ============================================================
    // Keccak-f[1600] round constants
    // ============================================================

    function automatic bit [63:0] rc(
        input int round
    );

        case(round)

             0:return 64'h0000000000000001;
             1:return 64'h0000000000008082;
             2:return 64'h800000000000808A;
             3:return 64'h8000000080008000;
             4:return 64'h000000000000808B;
             5:return 64'h0000000080000001;
             6:return 64'h8000000080008081;
             7:return 64'h8000000000008009;

             8:return 64'h000000000000008A;
             9:return 64'h0000000000000088;
            10:return 64'h0000000080008009;
            11:return 64'h000000008000000A;
            12:return 64'h000000008000808B;
            13:return 64'h800000000000008B;
            14:return 64'h8000000000008089;
            15:return 64'h8000000000008003;

            16:return 64'h8000000000008002;
            17:return 64'h8000000000000080;
            18:return 64'h000000000000800A;
            19:return 64'h800000008000000A;
            20:return 64'h8000000080008081;
            21:return 64'h8000000000008080;
            22:return 64'h0000000080000001;
            23:return 64'h8000000080008008;

        endcase

        return '0;

    endfunction



    // ============================================================
    // Keccak-f[1600]
    //
    // 一次 permutation 固定做 24 rounds
    //
    // 每 round：
    //
    // Theta
    // Rho
    // Pi
    // Chi
    // Iota
    // ============================================================

    task automatic keccak_f1600(
        inout bit [63:0] A [0:24]
    );

        bit [63:0] C [0:4];
        bit [63:0] D [0:4];
        bit [63:0] B [0:24];

        int x;
        int y;

        int new_x;
        int new_y;


        for (
            int round = 0;
            round < 24;
            round++
        ) begin


            // ====================================================
            // THETA
            //
            // 每個 column 的 5 個 lane XOR 起來
            // ====================================================

            for (x = 0; x < 5; x++) begin

                C[x] =
                      A[x]
                    ^ A[x+5]
                    ^ A[x+10]
                    ^ A[x+15]
                    ^ A[x+20];

            end


            // ====================================================
            // 計算每個 column 要 XOR 的 correction value
            // ====================================================

            for (x = 0; x < 5; x++) begin

                D[x] =
                      C[(x+4)%5]
                    ^
                      rotl64(
                          C[(x+1)%5],
                          1
                      );

            end


            // ====================================================
            // 把 D[x] XOR 到該 column 全部 lane
            // ====================================================

            for (y = 0; y < 5; y++) begin

                for (x = 0; x < 5; x++) begin

                    A[x+5*y] ^=
                        D[x];

                end

            end


            // ====================================================
            // RHO + PI
            //
            // Rho = rotate
            // Pi  = relocate lane
            // ====================================================

            for (x = 0; x < 25; x++)
                B[x] = '0;


            for (y = 0; y < 5; y++) begin

                for (x = 0; x < 5; x++) begin

                    new_x =
                        y;

                    new_y =
                        (2*x + 3*y) % 5;


                    B[
                        new_x + 5*new_y
                    ] =
                        rotl64(
                            A[x + 5*y],
                            rho_offset(x,y)
                        );

                end

            end


            // ====================================================
            // CHI
            //
            // Keccak 唯一主要的 nonlinear step
            // ====================================================

            for (y = 0; y < 5; y++) begin

                for (x = 0; x < 5; x++) begin

                    A[x + 5*y] =
                          B[x + 5*y]
                        ^
                        (
                            (~B[
                                ((x+1)%5)
                                + 5*y
                              ])
                            &
                            B[
                                ((x+2)%5)
                                + 5*y
                             ]
                        );

                end

            end


            // ====================================================
            // IOTA
            //
            // 把 round constant XOR 到 A[0][0]
            // ====================================================

            A[0] ^=
                rc(round);

        end

    endtask



    // ============================================================
    // Absorb 一個完整 SHA3-384 block
    //
    // 一個 block = 104 bytes
    // ============================================================

    task automatic absorb_block(
        inout bit [63:0] A [0:24],
        input byte unsigned block [0:103]
    );

        int lane;
        int byte_pos;

        bit [63:0] temp;


        for (
            int i = 0;
            i < SHA3_RATE_BYTES;
            i++
        ) begin


            // ----------------------------------------------------
            // 每 8 bytes 組成一個 64-bit lane
            // ----------------------------------------------------

            lane =
                i / 8;

            byte_pos =
                i % 8;


            // ----------------------------------------------------
            // SHA3 lane 是 little-endian
            //
            // block[0] -> lane[7:0]
            // block[1] -> lane[15:8]
            // ...
            // ----------------------------------------------------

            temp =
                {56'h0, block[i]};


            A[lane] ^=
                temp << (byte_pos * 8);

        end


        // absorb 完一個 block 後，
        // 執行一次 Keccak-f[1600]
        // After absorbing one block,
        // execute one Keccak-f[1600] permutation

        keccak_f1600(A);

    endtask



    // ============================================================
    // SHA3-384 golden model
    // ============================================================

    task automatic sha3_384(
        input byte unsigned msg[],
        output bit [383:0] digest
    );

        bit [63:0] A [0:24];
        // 1600-bit Keccak state
        //
        // 25 * 64 = 1600

        byte unsigned block [0:103];
        // SHA3-384 rate block = 104 bytes

        byte unsigned digest_byte [0:47];
        // SHA3-384 digest = 48 bytes

        int offset;
        int remain;

        int lane;
        int byte_pos;


        // ========================================================
        // 1. 初始化 state = 0
        // ========================================================

        for (int i = 0; i < 25; i++)
            A[i] = '0;


        offset = 0;


        // ========================================================
        // 2. Absorb 所有完整 104-byte block
        // ========================================================

        while (
            (msg.size() - offset)
            >= SHA3_RATE_BYTES
        ) begin


            for (
                int i = 0;
                i < SHA3_RATE_BYTES;
                i++
            ) begin

                block[i] =
                    msg[offset + i];

            end


            absorb_block(
                A,
                block
            );


            offset +=
                SHA3_RATE_BYTES;

        end


        // ========================================================
        // 3. 最後一個 block + padding
        // ========================================================

        for (
            int i = 0;
            i < SHA3_RATE_BYTES;
            i++
        ) begin

            block[i] =
                8'h00;

        end


        remain =
            msg.size() - offset;


        for (
            int i = 0;
            i < remain;
            i++
        ) begin

            block[i] =
                msg[offset + i];

        end


        // --------------------------------------------------------
        // SHA3 domain separator
        //
        // SHA-3 使用 0x06
        // --------------------------------------------------------

        block[remain] ^=
            8'h06;


        // --------------------------------------------------------
        // pad10*1 最後一個 bit
        //
        // 最後 rate byte 的 MSB 設為 1
        // --------------------------------------------------------

        block[
            SHA3_RATE_BYTES - 1
        ] ^=
            8'h80;


        absorb_block(
            A,
            block
        );


        // ========================================================
        // 4. Squeeze 前 48 bytes
        // ========================================================

        for (
            int i = 0;
            i < SHA3_DIGEST_BYTES;
            i++
        ) begin

            lane =
                i / 8;

            byte_pos =
                i % 8;


            digest_byte[i] =
                A[lane][
                    byte_pos*8 +: 8
                ];

        end


        // ========================================================
        // 5. Pack 成 bit[383:0]
        //
        // 目的是讓：
        //
        // $display("%096h", digest)
        //
        // 顯示順序跟 Python hexdigest() 一樣
        // ========================================================

        digest = '0;


        for (
            int i = 0;
            i < SHA3_DIGEST_BYTES;
            i++
        ) begin

            digest[
                383 - i*8 -: 8
            ] =
                digest_byte[i];

        end

    endtask



    // ============================================================
    // Golden model self test
    // ============================================================

    task automatic sha3_384_self_test();

        byte unsigned msg[];

        bit [383:0] result;


        // ========================================================
        // Test vector #1
        //
        // SHA3-384("")
        // ========================================================

        msg =
            new[0];


        sha3_384(
            msg,
            result
        );


        if (
            result !==
            384'h0c63a75b845e4f7d01107d852e4c2485
                 c51a50aaaa94fc61995e71bbee983a2a
                 c3713831264adb47fb6bd1e058d5f004
        ) begin

            `uvm_fatal(
                "SHA3_REF",
                $sformatf(
                    "SHA3-384(empty) failed: %096h",
                    result
                )
            )

        end


        // ========================================================
        // Test vector #2
        //
        // SHA3-384("abc")
        // ========================================================

        msg =
            new[3];


        msg[0] =
            8'h61;
        // 'a'

        msg[1] =
            8'h62;
        // 'b'

        msg[2] =
            8'h63;
        // 'c'


        sha3_384(
            msg,
            result
        );


        if (
            result !==
            384'hec01498288516fc926459f58e2c6ad8d
                 f9b473cb0fc08c2596da7cf0e49be4b2
                 98d88cea927ac7f539f1edf228376d25
        ) begin

            `uvm_fatal(
                "SHA3_REF",
                $sformatf(
                    "SHA3-384(abc) failed: %096h",
                    result
                )
            )

        end


        `uvm_info(
            "SHA3_REF",
            "SHA3-384 reference model self-test PASS",
            UVM_LOW
        )

    endtask


