        // ========================================================

        dut_apb_write(
            {24'h1005_2d, 6'h3f, 2'h0},
            32'h0000_0004
        );


        idx = 0;


        // ========================================================
        // 開始把整包 message 切成 1/2/3/4 bytes 寫入
        // ========================================================

        while (idx < sha_data.size()) begin

            pwdata = 32'h0;
            // 每次先清 0，避免上一次 write 殘值留下來
            // Clear the word before every write


            // ----------------------------------------------------
            // legacy packing：
            //
            // 第一個 message byte -> pwdata[7:0]
            // 第二個 message byte -> pwdata[15:8]
            // 第三個 message byte -> pwdata[23:16]
            // 第四個 message byte -> pwdata[31:24]
            //
            // 例如：
            //
            // message = A3 B4 C5 D6
            //
            // APB data = 32'hD6C5B4A3
            //
            // 注意：
            // 這不是把 message reverse，
            // 而是第一個 byte 放 lowest byte lane
            // ----------------------------------------------------

            for (
                int byte_idx = 0;
                byte_idx < bytes_per_write;
                byte_idx++
            ) begin

                if ((idx + byte_idx) < sha_data.size()) begin

                    pwdata[
                        byte_idx*8 +: 8
                    ] =
                        sha_data[
                            idx + byte_idx
                        ];

                end

            end


            // ----------------------------------------------------
            // legacy data write address：
            //
            // paddress <= {24'h1005_2d,6'h35,2'h0};
            // ----------------------------------------------------

            dut_apb_write(
                {24'h1005_2d, 6'h35, 2'h0},
                pwdata
            );


            `uvm_info(
                "SHA3_DATA_WRITE",
                $sformatf(
                    "idx=%0d pwdata=%08h bytes_per_write=%0d",
                    idx,
                    pwdata,
                    bytes_per_write
                ),
                UVM_HIGH
            )


            idx += bytes_per_write;

        end


        // ========================================================
        // legacy 最後：
        //
        // paddress <= {24'h1005_2d,6'h3f,2'h0};
        // pwdata   <= {24'b0,8'd8};
        //
        // comment = FW block write end
        //
        // 表示 message write 結束
        // ========================================================

        dut_apb_write(
            {24'h1005_2d, 6'h3f, 2'h0},
            32'h0000_0008
        );

    endtask



