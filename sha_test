    task automatic write_sha3_message();

        int bytes_per_write;
        // 每次 APB write 寫幾個 byte
        // Number of bytes per APB write

        int idx;
        // 目前 message byte index
        // Current message byte index

        bit [31:0] pwdata;
        // 一次送出去的 32-bit APB data
        // 32-bit APB write data


        // --------------------------------------------------------
        // block_wr_num：
        //
        // 0 -> 1 byte
        // 1 -> 2 bytes
        // 2 -> 3 bytes
        // 3 -> 4 bytes
        //
        // 所以 bytes_per_write = block_wr_num + 1
        // --------------------------------------------------------

        bytes_per_write =
            int'(block_wr_num) + 1;


        // ========================================================
        // legacy 第一段：
        //
        // paddress <= {24'h1005_2d,6'h3f,2'h0};
